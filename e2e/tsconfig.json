{
    "compilerOptions": {
        "target": "ES2022",
        "useDefineForClassFields": true,
        "lib": [
            "ES2023",
            "DOM",
            "DOM.Iterable"
        ],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "skipLibCheck": true,
        "allowImportingTsExtensions": true,
        "isolatedModules": true,
        "moduleDetection": "force",
        "verbatimModuleSyntax": true,
        "noEmit": true,
        "strict": true
    },
    "include": [
        "src",
        "tests",
        "*.config.ts",
        "*.config.js"
    ]
}
